PORT=6258
ADMIN_PIN=123456
ARIA2_RPC_URL=http://127.0.0.1:6800/jsonrpc
ARIA2_RPC_SECRET=
# GOFILE_API_TOKEN=
PIXELDRAIN_API_TOKEN=
DEFAULT_STORAGE_PROVIDER=pixeldrain
DATA_DIR=./data
JWT_SECRET=gotouch_secret_key_change_in_production

# Aria2c Executable & Auto-Start Settings
# Set AUTO_START_ARIA2=true to automatically spawn aria2c if daemon is not running.
# Set ARIA2_PATH to explicit path (e.g. C:\Program Portable\aria2c\aria2c.exe on Windows, or aria2c on Linux VPS).
AUTO_START_ARIA2=true
ARIA2_PATH=aria2c

# Debug Logging Mode (Set true for verbose terminal output)
DEBUG=false

# S3 Image & Thumbnail Storage (iDrive e2 / AWS S3 / MinIO / Cloudflare R2 / Wasabi)
# All image screenshots/thumbnails are uploaded to S3 under S3_FOLDER_PREFIX (e.g. aria2c/)
S3_ENDPOINT=https://your-endpoint.idrivee2-XX.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_BUCKET=your_s3_bucket_name
S3_FOLDER_PREFIX=aria2c

# MongoDB Database Configuration (Inspectable via MongoDB Compass)
# Supports both MONGO_URI or MONGODB_URI (Local instance or MongoDB Atlas Cloud):
# Example Atlas: MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/gotouch?appName=...
# Example Local: MONGO_URI=mongodb://127.0.0.1:27017/gotouch
# If left empty, the application automatically uses local flat-file storage (data/files.json).
MONGO_URI=
MONGODB_DB_NAME=gotouch



